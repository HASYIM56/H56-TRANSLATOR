{
  "name": "h56-translator",
  "version": "1.0.8",
  "description": "A simple and modern translator wrapper for h56-translator-api with CLI support and online documentation.",
  "main": "translate.js",
  "type": "commonjs",
  "exports": {
    ".": "./translate.js"
  },
  "bin": {
    "h56-translator": "info/info.js"
  },
  "files": [
    "translate.js",
    "info/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node translate.js",
    "cli": "node info/info.js",
    "test": "echo \"No tests specified\" && exit 0",
    "docs": "echo \"Open docs at https://h56-translator-web-docs.netlify.app/\""
  },
  "keywords": [
    "translator",
    "translate",
    "api",
    "h56",
    "npm",
    "translatorservice",
    "hasyim56",
    "language",
    "cli",
    "translation",
    "wrapper",
    "nodejs"
  ],
  "author": {
    "name": "Muhammad Ali Hasyim",
    "email": "m.aliahasyim1802@gmail.com",
